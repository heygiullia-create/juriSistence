GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=1
GEMINI_RETRY_DELAY_MS=800

# Fallback gratuito pela Groq. Usado automaticamente quando o Gemini falha por
# alta demanda, rate limit, timeout ou indisponibilidade temporaria.
GROQ_API_KEY=sua_chave_groq_aqui
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=30000

# Fallback gratuito via OpenRouter. Escolha um modelo com sufixo :free em:
# https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=sua_chave_openrouter_aqui
OPENROUTER_MODEL=coloque_um_modelo_free_aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_APP_NAME=JuriSistence

# Ajustes de velocidade para deploy temporario/gratuito.
MODO_RAPIDO=true
HTTP_TIMEOUT_MS=3500
HTTP_MAX_RETRIES=0
HTTP_RETRY_DELAY_MS=300
LIMITE_TEMAS_PESQUISA=2
LIMITE_CARACTERES_POR_DOCUMENTO=1800
LIMITE_DOCUMENTOS_RELATORIO=6
